pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Setup Build Tool') {
            steps {
                dir('test1') {
                    sh '''
                    if ! command -v mvn &> /dev/null; then
                        echo "Maven not found! Downloading Maven 3.9.5..."
                        curl -sL -o apache-maven-3.9.5-bin.tar.gz https://archive.apache.org/dist/maven/maven-3/3.9.5/binaries/apache-maven-3.9.5-bin.tar.gz
                        tar -xzf apache-maven-3.9.5-bin.tar.gz
                    fi
                    '''
                }
            }
        }
        stage('Build') {
            steps {
                echo 'Building the project...'
                dir('test1') {
                    sh '''
                    export MAVEN_HOME="$(pwd)/apache-maven-3.9.5"
                    export PATH="$MAVEN_HOME/bin:$PATH"
                    mvn clean compile
                    '''
                }
            }
        }
        stage('Test') {
            steps {
                echo 'Testing...'
                dir('test1') {
                    sh '''
                    export MAVEN_HOME="$(pwd)/apache-maven-3.9.5"
                    export PATH="$MAVEN_HOME/bin:$PATH"
                    mvn test
                    '''
                }
            }
        }
    }
    
    post {
        success {
            echo '빌드 성공! 결과 파일을 생성합니다.'
            
            sh 'echo "Build Successful at $(date)" > build_success_result.txt'
            archiveArtifacts artifacts: 'build_success_result.txt', allowEmptyArchive: true
            mail to: 'darkbaag12@gmail.com',
                 subject: "Jenkins 빌드 성공 알림: ${env.JOB_NAME} [${env.BUILD_NUMBER}]",
                 body: "빌드가 성공적으로 완료되었습니다.\n\n프로젝트: ${env.JOB_NAME}\n빌드 번호: ${env.BUILD_NUMBER}\n상세 확인: ${env.BUILD_URL}"
        }
        failure {
            echo '빌드 실패! Jenkins 로그를 확인하고 원인을 분석하세요.'
        }
    }
}
